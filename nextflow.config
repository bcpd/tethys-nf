nextflow.enable.dsl=2

params {
  mode        = 'all'            // build | profile | merge | all
  genomes_dir = null             // directory of assemblies (*.fna|*.fa)
  reads       = null             // glob of reads '*_{R1,R2}.fastq.gz'
  outdir      = 'results'        // output root
  threads     = 8

  // Databases / indexes
  kofam_db    = null             // central KOfam DB root
  annotation_backend = 'pykofamsearch' // pykofamsearch (default) | kofamscan
  checkm2_db  = null             // central CheckM2 DB root (or env CHECKM2DB)
  pathway_db  = null             // optional pathway db; can be built automatically
  index_dir   = null             // optional: reuse a prebuilt Tethys index
  skip_checkm2 = false           // set true to skip CHECKM2 quality step
  kofam_cpus  = null             // optional: per-task CPU for KOFAM_SCAN (defaults to smaller value to allow parallelism)
}

profiles {
  conda  { includeConfig 'conf/conda.config' }
  linux  { includeConfig 'conf/linux.config' }
  mac    { includeConfig 'conf/mac.config' }
  docker { includeConfig 'conf/docker.config' }
}

process {
  withName: CLUSTER_SKANI        { cpus = params.threads; memory = 8.GB; time = '12h' }
  withName: PRODIGAL_PYRO        { cpus = params.threads; memory = 8.GB }
  withName: KOFAM_SCAN           { cpus = (params.kofam_cpus ?: Math.min(2, params.threads)); memory = 8.GB }
  withName: CONCAT_KOFAM         { cpus = 2; memory = 2.GB }
  withName: BUILD_MANIFEST       { cpus = 1; memory = 2.GB }
  withName: TETHYS_PREPROCESS { cpus = 4; memory = 8.GB }
  withName: TETHYS_INDEX      { cpus = params.threads; memory = 16.GB; time = '24h' }
  withName: PROFILE_TAX          { cpus = params.threads; memory = 8.GB }
  withName: PROFILE_FUNC         { cpus = params.threads; memory = 12.GB }
  withName: MERGE_ARTIFACTS      { cpus = 4; memory = 6.GB }
}

conda {
  enabled        = true
  useMicromamba  = true
  cacheDir       = "${projectDir}/.conda"
  createOptions  = '-y'
}
